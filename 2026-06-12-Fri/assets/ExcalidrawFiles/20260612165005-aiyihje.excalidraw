      "isDeleted": false,
      "boundElements": null,
      "updated": 1781255519339,
      "link": null,
      "locked": false,
      "text": "1 边坡几何核查方面，典型断面自动提取成功率应不低于95%；",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1 边坡几何核查方面，典型断面自动提取成功率应不低于95%；",
      "autoResize": true,
      "lineHeight": 1.2
    },
    {
      "id": "AX5997uMBGnzrSrhDzcHi",
      "type": "text",
      "x": 4437.967874086084,
      "y": 1745.178541874654,
      "width": 798.59375,
      "height": 48,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
