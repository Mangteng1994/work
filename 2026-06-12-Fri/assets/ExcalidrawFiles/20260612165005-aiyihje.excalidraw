      "type": "text",
      "x": 1211.8372302050275,
      "y": 332.5506830252475,
      "width": 800,
      "height": 96,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
