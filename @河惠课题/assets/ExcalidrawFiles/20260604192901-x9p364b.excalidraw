      "isDeleted": false,
      "boundElements": [],
      "updated": 1780573233686,
      "link": null,
      "locked": false,
      "text": "相对于昼间，夜间平均车速不降反而有略微提升，标准差增大，有较大安全隐患",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "相对于昼间，夜间平均车速不降反而有略微提升，标准差增大，有较大安全隐患",
      "autoResize": false,
      "lineHeight": 1.2
    },
    {
      "id": "aiXBbh4X4Vh-YKx0LKlNm",
      "type": "text",
      "x": -234.7375406620679,
      "y": 1282.049322555554,
      "width": 180,
      "height": 24,
      "angle": 0,
