    },
    {
      "id": "gq-LEFKRlohLf07dk7bpO",
      "type": "text",
      "x": -441.1614306184241,
      "y": 1593.8830245514303,
      "width": 800,
      "height": 72,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "af",
      "roundness": null,
      "seed": 1168004074,
      "version": 3,
      "versionNonce": 281825526,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780573409554,
      "link": null,
      "locked": false,
      "text": "速度标准差先上升后下降，推测驾驶人对于中央分隔带开口的路况并不熟悉，起初速度存在\n一定差异，随驶入的深入，驾驶条件低于驾驶人预期，因此普遍采取降速，速度标准差因而\n降低，交通安全水平逐步提升",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "速度标准差先上升后下降，推测驾驶人对于中央分隔带开口的路况并不熟悉，起初速度存在一定差异，随驶入的深入，驾驶条件低于驾驶人预期，因此普遍采取降速，速度标准差因而降低，交通安全水平逐步提升",
      "autoResize": false,
      "lineHeight": 1.2
    },
