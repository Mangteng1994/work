    },
    {
      "id": "z0r_wxDcECafOrgQwt62V",
      "type": "text",
      "x": -326.2397505156514,
      "y": 1362.5911224601134,
      "width": 780,
      "height": 48,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
