      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "排队扩散：车道递减、交通转换、分合流造成局部瓶颈",
      "autoResize": true,
      "lineHeight": 1.2
    },
    {
      "id": "O13fqY3uyoUwdCvqVGABc",
      "type": "text",
      "x": -1399.9914947100897,
      "y": 1023.9119431996191,
      "width": 360,
      "height": 24,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
