      "updated": 1780573250084,
      "link": null,
      "locked": false,
      "text": "连续车道数递减场景",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "连续车道数递减场景",
