    {
      "id": "uUuxSPR4twM97avSf5qED",
      "type": "text",
      "x": 1534.145410051816,
      "y": 1288.8226574853336,
      "width": 800,
      "height": 48,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
