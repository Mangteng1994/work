      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "夜间，空间检索，视线不足，\n注意力集中，身心负荷加大",
      "autoResize": true,
      "lineHeight": 1.2
    },
