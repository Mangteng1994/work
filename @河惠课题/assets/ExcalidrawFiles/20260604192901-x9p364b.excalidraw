      "versionNonce": 30147434,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780573588852,
      "link": null,
      "locked": false,
      "text": "速度偏离，实际速度高于限速或设计速度",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "速度偏离，实际速度高于限速或设计速度",
