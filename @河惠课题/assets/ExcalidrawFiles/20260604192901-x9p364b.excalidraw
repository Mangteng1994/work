      "updated": 1780573398411,
      "link": null,
      "locked": false,
      "text": "（1）中央分隔带开口",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "（1）中央分隔带开口",
