    {
      "id": "ZZOnm98qFEIyfbexsksgc",
      "type": "text",
      "x": 3150.8247255280075,
      "y": 12563.07980034247,
      "width": 237.09375,
      "height": 43.199999999999996,
      "angle": 0,
      "strokeColor": "#1e1e1e",
