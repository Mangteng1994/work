      "text": "（1）实验设计",
      "fontSize": 36,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "（1）实验设计",
      "autoResize": true,
      "lineHeight": 1.2
    },
    {
      "id": "_WZCZQ0PmRoxkDeIAy69x",
      "type": "rectangle",
      "x": 4416.454933861341,
      "y": 13478.846467009136,
