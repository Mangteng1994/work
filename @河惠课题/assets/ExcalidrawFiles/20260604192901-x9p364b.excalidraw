    {
      "id": "3_5xu5P8xqaSvcUo0wRng",
      "type": "text",
      "x": -318.1376275086634,
      "y": 1225.5345123066354,
      "width": 763.4375,
      "height": 24,
      "angle": 0,
      "strokeColor": "#1e1e1e",
