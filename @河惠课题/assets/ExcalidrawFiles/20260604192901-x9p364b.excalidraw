      "versionNonce": 557330870,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780573984111,
      "link": null,
      "locked": false,
      "text": "断面空间压缩破坏了正常的驾驶空间环境，车辆运行轨迹稳定性大幅下降，波动范围明显扩\n大",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "断面空间压缩破坏了正常的驾驶空间环境，车辆运行轨迹稳定性大幅下降，波动范围明显扩大",
      "autoResize": false,
      "lineHeight": 1.2
    },
    {
      "id": "VTST9V9IXi4dTBaCE4qV9",
      "type": "text",
      "x": 2996.1751719565773,
      "y": 402.0786098662859,
      "width": 740,
      "height": 24,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
