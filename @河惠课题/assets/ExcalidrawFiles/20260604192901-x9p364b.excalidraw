    {
      "id": "ZgVmYhmes6npKjEKFWoKB",
      "type": "rectangle",
      "x": 4264.871600528008,
      "y": 9258.429800342476,
      "width": 1659,
      "height": 1005,
      "angle": 0,
      "strokeColor": "#1e1e1e",
